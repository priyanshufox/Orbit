# Copy to .env and fill in. Never commit .env.

# --- Shared ---
APP_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- API (FastAPI + worker) ---
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orbit-dev-password
# Shared secret used to sign short-lived API tokens minted by Next.js (task 2.4)
API_TOKEN_SECRET=change-me

# --- Web (Next.js + Auth.js) ---
AUTH_SECRET=change-me
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links (task 2.3)
EMAIL_FROM=
RESEND_API_KEY=

# --- Content pipeline (Phase 9) ---
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
NEWSDATA_API_KEY=
ANTHROPIC_API_KEY=
