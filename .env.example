# Copy to .env and fill in. Never commit .env. Both web/ and api/ read this root file.

# --- Shared ---
APP_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:8000

# --- API (FastAPI + worker) ---
DATABASE_URL=postgresql+asyncpg://orbit:orbit@localhost:5432/orbit
REDIS_URL=redis://localhost:6379/0
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=orbit-dev-password
# Sign-in tokens are issued by Better Auth in the web app and verified here against its public keys.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000

# --- Web (Next.js + Better Auth) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
BETTER_AUTH_URL=http://localhost:3000
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same database as the API; Better Auth keeps its tables in the "auth" schema.
AUTH_DATABASE_URL=postgresql://orbit:orbit@localhost:5432/orbit
# Google sign-in is enabled only when both are set.
# Redirect URI to register: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Magic-link email. Without RESEND_API_KEY (development only) links are printed to the web console.
EMAIL_FROM="Orbit <login@example.com>"
RESEND_API_KEY=

# --- Content pipeline (Phase 9) ---
IMGFLIP_USERNAME=
IMGFLIP_PASSWORD=
NEWSDATA_API_KEY=
ANTHROPIC_API_KEY=
